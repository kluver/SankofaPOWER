// For format details, see https://aka.ms/devcontainer.json.
{
	"name": "SankofaPOWER (Python, Node & PostGIS)",
	// The root compose file provides the database; ours adds the workspace container.
	"dockerComposeFile": [
		"../docker-compose.yml",
		"compose.devcontainer.yml"
	],
	"service": "workspace",
	// Only start the database and workspace; you run the api and web app yourself inside it.
	"runServices": [
		"db",
		"workspace"
	],
	"workspaceFolder": "/workspaces/SankofaPOWER",
	"features": {
		"ghcr.io/devcontainers/features/node:2.1.1": {
			"version": "24"
		},
		"ghcr.io/devcontainer-community/devcontainer-features/astral.sh-uv:1": {}
	},
	"forwardPorts": [
		8000,
		5173
	],
	// node_modules is a fresh docker volume owned by root, so hand it to the vscode user first.
	"postCreateCommand": "sudo chown vscode web/node_modules && uv sync && uv run alembic upgrade head && cd web && npm install",
	"customizations": {
		"vscode": {
			"extensions": [
				"ms-python.python"
			],
			"settings": {
				"python.defaultInterpreterPath": "/home/vscode/.venv/bin/python"
			}
		}
	}
}
